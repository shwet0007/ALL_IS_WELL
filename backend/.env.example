PORT=3001
NODE_ENV=development

# Firebase Config (Admin SDK)
# Provide the path to your service account JSON if used, or credentials individually if supported by your setup
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# OR
FIREBASE_PROJECT_ID=your-project-id

# Twilio (Calls)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890

# Cry Analysis
CRY_ANALYSIS_PYTHON_PATH=python 
# Use 'python3' on Linux/Mac

# Microservices
CRY_ANALYSIS_SERVICE_URL=http://localhost:8000
# For production: https://your-cry-analysis-service.onrender.com
